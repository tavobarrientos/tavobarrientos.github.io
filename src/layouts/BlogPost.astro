---
import { getCollection, type CollectionEntry } from 'astro:content';
import Layout from './Layout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Author from '../components/Author.astro';
import RelatedPosts from '../components/RelatedPosts.astro';
import SchemaOrg from '../components/SchemaOrg.astro';
import SocialShare from '../components/SocialShare.astro';
import PageHero from '../components/PageHero.astro';
import PostCard from '../components/PostCard.astro';
import { getReadingTime } from '../utils/readingTime';
import { lineById } from '../data/lines';

type Props = CollectionEntry<'blog'>['data'] & { body?: string; slug?: string };

const {
	title,
	description,
	pubDate,
	updatedDate,
	heroImage,
	author,
	relatedPosts,
	showAuthor = true,
	line: lineId,
	body,
	slug,
} = Astro.props;

// Generate keyword string from title and description
const keywords = `${title}, ${description}, blog, ${author?.id || 'tavobarrientos'}`;

const readingTime = getReadingTime(body || title + ' ' + description);
const line = lineById(lineId);

// Neighbours in publication order, for the previous/next pair
const ordered = (await getCollection('blog'))
	.filter((p) => !p.data.hidden)
	.sort((a, b) => a.data.pubDate.valueOf() - b.data.pubDate.valueOf());
const at = ordered.findIndex((p) => p.id === slug);
// Skip a neighbour that is already shown under Related articles
const shown = new Set((relatedPosts ?? []).map((r) => r.id));
const pick = (p: (typeof ordered)[number] | undefined) => (p && !shown.has(p.id) ? p : undefined);
const older = pick(at > 0 ? ordered[at - 1] : undefined);
const newer = pick(at >= 0 && at < ordered.length - 1 ? ordered[at + 1] : undefined);
---

<Layout
	title={title}
	description={description}
	image={heroImage}
	article={true}
	publishDate={pubDate}
	modifiedDate={updatedDate}
	keywords={keywords}
	fullBleed
>
	<Fragment slot="head">
		<SchemaOrg
			title={title}
			description={description}
			publishDate={pubDate}
			modifiedDate={updatedDate}
			image={heroImage}
			type="BlogPosting"
		/>
	</Fragment>

	<!-- Reading progress: fills as the article scrolls (see script below) -->
	<div
		data-progress
		aria-hidden="true"
		class="fixed left-0 top-0 z-[60] h-0.5 w-0 bg-accent"
	>
	</div>

	<PageHero
		slot="hero"
		photo="circuit"
		image={heroImage}
		narrow
		title={title}
		lead={description && description.trim() !== title.trim() ? description : undefined}
		transitionName={slug ? `post-title-${slug}` : undefined}
	>
		<a slot="above" href="/blog" class="mb-4 inline-flex min-h-11 items-center gap-2 text-sm font-medium text-ink-mid transition-colors hover:text-ink">
			<span aria-hidden="true">←</span> All articles
		</a>
		<div class="tnum flex flex-wrap items-center gap-x-4 gap-y-2 font-mono text-xs text-ink-mid">
			<span class={`line-chip line-${line.id}`}>{line.name}</span>
			<FormattedDate date={pubDate} />
			<span>{readingTime}</span>
			{updatedDate && <span>updated <FormattedDate date={updatedDate} /></span>}
		</div>
	</PageHero>

	<article class="container-x py-14 lg:py-20">
		<div class="prose prose-lg mx-auto max-w-[44rem]">
			<slot />
		</div>

		<!-- End matter: share, author -->
		<footer class="mx-auto mt-16 max-w-[44rem] divide-y divide-line border-y border-line">
			<div class="py-6">
				<SocialShare url={Astro.url.toString()} title={title} description={description} />
			</div>
			{showAuthor && (
				<div class="py-8">
					<Author author={author} />
				</div>
			)}
		</footer>
	</article>

	<!-- Keep reading -->
	<div class="bg-surface">
		<div class="container-x grid gap-16 py-16 lg:py-24">
			{relatedPosts && relatedPosts.length > 0 && <RelatedPosts related={relatedPosts} />}

			{
				(older || newer) && (
					<nav aria-label="More articles">
						<h2 class="text-2xl font-semibold md:text-3xl">Keep reading</h2>
						<ul class="mt-6 grid gap-x-8 gap-y-10 sm:grid-cols-2 lg:grid-cols-3" data-stagger>
							{newer && <li data-reveal><PostCard post={newer} label="Newer" /></li>}
							{older && <li data-reveal><PostCard post={older} label="Older" /></li>}
						</ul>
					</nav>
				)
			}
		</div>
	</div>
</Layout>

<script>
	// Reading progress bar. One global scroll listener (module loads once per
	// session); the bar element is re-queried after every client-side
	// navigation, so it's inert on pages without one.
	let bar: HTMLElement | null = null;

	const update = () => {
		if (!bar) return;
		const doc = document.documentElement;
		const max = doc.scrollHeight - doc.clientHeight;
		bar.style.width = max > 0 ? `${((window.scrollY / max) * 100).toFixed(2)}%` : '0%';
	};

	const rewire = () => {
		bar = document.querySelector<HTMLElement>('[data-progress]');
		update();
	};

	rewire();
	document.addEventListener('astro:page-load', rewire);
	window.addEventListener('scroll', update, { passive: true });
	window.addEventListener('resize', update, { passive: true });
</script>
