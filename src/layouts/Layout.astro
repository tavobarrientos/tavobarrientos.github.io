---
import { ClientRouter } from 'astro:transitions';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

export interface Props {
	title: string;
	description: string;
	image?: string;
	article?: boolean;
	publishDate?: Date;
	modifiedDate?: Date;
	keywords?: string;
	class?: string;
	fullBleed?: boolean;
}

const {
	title,
	description,
	image,
	article = false,
	publishDate,
	modifiedDate,
	keywords,
	class: className,
	fullBleed = false,
} = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="light">
	<head>
		<BaseHead
			title={title}
			description={description}
			image={image}
			article={article}
			publishDate={publishDate}
			modifiedDate={modifiedDate}
			keywords={keywords}
		/>
		<ClientRouter />
		<slot name="head" />
	</head>
	<body>
		<!-- Google Tag Manager (noscript) -->
		<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-59NK9D2X"
		height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
		<!-- End Google Tag Manager (noscript) -->
		<Header />
		<!-- Every page opens with its title block (the `hero` slot), which leaves
		     room for the fixed header; the page body follows. -->
		<main transition:name="content" class="w-full flex-1">
			<slot name="hero" />
			{
				fullBleed ? (
					<slot />
				) : (
					<div class:list={['container-x py-14 lg:py-20', className]}>
						<slot />
					</div>
				)
			}
		</main>
		<Footer />
		<script>
			import '../scripts/motion';
		</script>
	</body>
</html>
