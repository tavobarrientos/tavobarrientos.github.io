---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

export interface Props {
	title: string;
	description: string;
	image?: string;
	article?: boolean;
	publishDate?: Date;
	modifiedDate?: Date;
	keywords?: string;
	class?: string;
	fullBleed?: boolean;
}

const {
	title,
	description,
	image,
	article = false,
	publishDate,
	modifiedDate,
	keywords,
	class: className,
	fullBleed = false,
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={title}
			description={description}
			image={image}
			article={article}
			publishDate={publishDate}
			modifiedDate={modifiedDate}
			keywords={keywords}
		/>
		<slot name="head" />
	</head>
	<body>
		<!-- Google Tag Manager (noscript) -->
		<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-59NK9D2X"
		height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
		<!-- End Google Tag Manager (noscript) -->
		<Header />
		<main
			class:list={[
				'w-full flex-1',
				!fullBleed && 'max-w-6xl mx-auto px-6 lg:px-8 py-12',
				className,
			]}
		>
			<slot />
		</main>
		<Footer />
		<script>
			import '../scripts/scroll-reveal';
		</script>
	</body>
</html>
