---
import type { CollectionEntry } from 'astro:content';
import Layout from './Layout.astro';
import SchemaOrg from '../components/SchemaOrg.astro';
import OptimizedImage from '../components/OptimizedImage.astro';
import PageHero from '../components/PageHero.astro';

type Props = CollectionEntry<'projects'>['data'] & {
	slug: string;
};

const { title, description, heroImage, images, links, tags } = Astro.props;

// Generate keyword string from title and description
const keywords = `${title}, ${description}, project, portfolio, software development`;

const navButton =
	'pointer-events-auto mx-5 flex h-[50px] w-[50px] cursor-pointer items-center justify-center rounded-full bg-white/90 text-lg font-bold text-[#333] shadow-[0_2px_10px_rgb(0_0_0/0.3)] transition-all duration-300 hover:scale-110 hover:bg-white disabled:cursor-not-allowed disabled:opacity-50 disabled:hover:scale-100';
---

<Layout title={title} description={description} image={heroImage} keywords={keywords}>
	<Fragment slot="head">
		<SchemaOrg title={title} description={description} image={heroImage} type="WebPage" />
	</Fragment>

	<PageHero
		slot="hero"
		photo="board"
		title={title}
		lead={description}
		transitionName={`project-title-${Astro.props.slug}`}
	>
		<div class="flex flex-wrap items-center gap-3">
			{links?.website && <a href={links.website} target="_blank" rel="noopener noreferrer" class="btn btn-solid">Visit website</a>}
			{links?.demo && <a href={links.demo} target="_blank" rel="noopener noreferrer" class="btn btn-solid">Live demo</a>}
			{links?.github && <a href={links.github} target="_blank" rel="noopener noreferrer" class="btn btn-ghost">View on GitHub</a>}
		</div>
	</PageHero>

	<article class="mx-auto w-full max-w-3xl">
		{
			tags && tags.length > 0 && (
				<ul class="mb-10 flex flex-wrap gap-2">
					{tags.map((tag) => (
						<li class="rounded-full border border-rule px-3 py-1 font-mono text-xs text-ink-mid">{tag}</li>
					))}
				</ul>
			)
		}
		<div class="prose prose-lg max-w-none">
			<slot />
		</div>

		{
			images && images.length > 0 && (
				<div class="mt-12">
					<h3 class="mb-4 text-center text-xl font-semibold text-ink">Gallery</h3>
					<div class="mb-8 grid grid-cols-1 gap-3 md:grid-cols-[repeat(auto-fit,minmax(300px,1fr))] md:gap-4">
						{images.map((image, index) => (
							<button
								type="button"
								data-gallery-item
								aria-label={`Open screenshot ${index + 1} of ${images.length}`}
								class="group relative cursor-pointer overflow-hidden rounded-lg border border-line transition-[translate,box-shadow] duration-300 hover:-translate-y-[5px] hover:shadow-[0_8px_24px_rgb(10_15_26/0.14)]"
							>
								<OptimizedImage
									width={400}
									height={250}
									src={image}
									alt={`${title} screenshot ${index + 1}`}
									css="h-auto w-full transition-transform duration-300 group-hover:scale-105"
								/>
							</button>
						))}
					</div>
				</div>
			)
		}

		<!-- Lightbox: hidden until a gallery image is opened (the script swaps
		     `hidden` for `flex`). It is a popover so it opens in the top layer,
		     above the fixed header; the size and spacing classes undo the
		     browser's default popover box. -->
		<div
			data-lightbox
			popover="manual"
			role="dialog"
			aria-modal="true"
			aria-label="Screenshot viewer"
			class="fixed inset-0 m-0 hidden h-full max-h-none w-full max-w-none items-center justify-center border-0 bg-black/90 p-0 motion-safe:animate-fade-in"
		>
			<div class="relative m-auto flex max-h-[95%] max-w-[95%] flex-col items-center md:max-h-[90%] md:max-w-[90%]">
				<button
					type="button"
					data-lightbox-close
					aria-label="Close"
					class="absolute -top-[35px] right-0 z-[1001] cursor-pointer text-[28px] font-bold leading-none text-white transition-colors duration-300 hover:text-[#ccc] md:-top-10 md:text-[35px]"
				>
					&times;
				</button>
				<img
					data-lightbox-image
					alt=""
					class="max-h-[70vh] max-w-full touch-none rounded-lg object-contain shadow-[0_4px_20px_rgb(0_0_0/0.5)] md:max-h-[80vh] md:touch-auto"
				/>
				<!-- Arrows on desktop; phones swipe instead -->
				<div class="pointer-events-none absolute top-1/2 hidden w-full -translate-y-1/2 justify-between md:flex">
					<button type="button" data-lightbox-prev aria-label="Previous image" class={navButton}>‹</button>
					<button type="button" data-lightbox-next aria-label="Next image" class={navButton}>›</button>
				</div>
				<div class="mt-[15px] text-center text-sm text-white">
					<span data-lightbox-counter>1 / 1</span>
					<div data-lightbox-hint class="mt-2 text-xs text-white/70 md:hidden">Swipe to navigate</div>
				</div>
			</div>
		</div>
	</article>
</Layout>

<script>
	// Gallery lightbox. Re-wired on every client-side navigation; the previous
	// page's document-level listeners are dropped through the AbortController.
	let wired: AbortController | null = null;

	function initLightbox() {
		wired?.abort();
		const box = document.querySelector<HTMLElement>('[data-lightbox]');
		const image = document.querySelector<HTMLImageElement>('[data-lightbox-image]');
		const close = document.querySelector<HTMLButtonElement>('[data-lightbox-close]');
		const prev = document.querySelector<HTMLButtonElement>('[data-lightbox-prev]');
		const next = document.querySelector<HTMLButtonElement>('[data-lightbox-next]');
		const counter = document.querySelector<HTMLElement>('[data-lightbox-counter]');
		const hint = document.querySelector<HTMLElement>('[data-lightbox-hint]');
		const items = Array.from(document.querySelectorAll<HTMLElement>('[data-gallery-item]'));
		if (!box || !image || !close || !prev || !next || !counter || !hint || !items.length) return;

		wired = new AbortController();
		const { signal } = wired;

		const images = items.flatMap((item, i) => {
			const img = item.querySelector('img');
			return img ? [{ src: img.src, alt: img.alt || `Image ${i + 1}` }] : [];
		});
		let current = 0;
		let opener: HTMLElement | null = null;
		const isOpen = () => !box.classList.contains('hidden');

		const render = () => {
			const shown = images[current];
			if (!shown) return;
			image.src = shown.src;
			image.alt = shown.alt;
			counter.textContent = `${current + 1} / ${images.length}`;
			prev.disabled = current === 0;
			next.disabled = current === images.length - 1;
			// One image: nothing to navigate
			const single = images.length <= 1;
			prev.hidden = single;
			next.hidden = single;
			hint.hidden = single;
		};
		const go = (step: number) => {
			const to = current + step;
			if (to < 0 || to > images.length - 1) return;
			current = to;
			render();
		};
		const open = (index: number, from: HTMLElement) => {
			current = index;
			opener = from;
			box.showPopover();
			box.classList.replace('hidden', 'flex');
			document.body.style.overflow = 'hidden';
			render();
			close.focus();
		};
		const shut = () => {
			box.classList.replace('flex', 'hidden');
			box.hidePopover();
			document.body.style.overflow = '';
			opener?.focus();
		};

		items.forEach((item, i) => item.addEventListener('click', () => open(i, item), { signal }));
		close.addEventListener('click', shut, { signal });
		// A click on the backdrop, outside the image, closes it
		box.addEventListener('click', (e) => e.target === box && shut(), { signal });
		prev.addEventListener('click', () => go(-1), { signal });
		next.addEventListener('click', () => go(1), { signal });

		document.addEventListener(
			'keydown',
			(e) => {
				if (!isOpen()) return;
				if (e.key === 'Escape') shut();
				else if (e.key === 'ArrowLeft') go(-1);
				else if (e.key === 'ArrowRight') go(1);
			},
			{ signal }
		);

		// Horizontal swipes on the image change it; vertical movement is ignored
		let startX = 0;
		let startY = 0;
		image.addEventListener(
			'touchstart',
			(e) => {
				startX = e.changedTouches[0].screenX;
				startY = e.changedTouches[0].screenY;
			},
			{ signal, passive: true }
		);
		image.addEventListener(
			'touchend',
			(e) => {
				const dx = e.changedTouches[0].screenX - startX;
				const dy = e.changedTouches[0].screenY - startY;
				if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy)) go(dx < 0 ? 1 : -1);
			},
			{ signal, passive: true }
		);
	}

	document.addEventListener('astro:page-load', initLightbox);
	// Leaving the page with the lightbox open must not leave scrolling locked
	document.addEventListener('astro:before-swap', () => (document.body.style.overflow = ''));
</script>
