---
import Layout from '../layouts/Layout.astro';
import HeroGraph from '../components/three/HeroGraph.astro';
import PostRow from '../components/PostRow.astro';
import ProjectPreview from '../components/ProjectPreview.astro';
import { Icon } from 'astro-icon/components';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import profileData from '../data/profile.json';
import { getCollection } from 'astro:content';

const profile = profileData;
const company = profile.company;
// Tagline mid-sentence: lowercase only the leading word, keep acronyms intact
const taglineInline = company.tagline.charAt(0).toLowerCase() + company.tagline.slice(1);

const posts = (await getCollection('blog'))
	.filter((post) => !post.data.hidden)
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 4);

const projects = (await getCollection('projects')).filter((project) => !project.data.hidden);

const stack = [
	'C# / .NET',
	'TypeScript',
	'Python',
	'Azure AI',
	'Microsoft Agent Framework',
	'Microsoft Copilot Studio',
	'Semantic Kernel',
	'LangChain',
	'LLM Agents',
	'MCP',
	'React',
	'Node.js',
	'Docker',
	'CI/CD',
	'Microservices',
];
---

<Layout title={SITE_TITLE} description={SITE_DESCRIPTION} fullBleed>
	<HeroGraph />

	<!-- Stack ticker: the toolbox, scrolling like a status line -->
	<div class="reveal border-y border-line/70 bg-surface/40 py-4 backdrop-blur-sm">
		<div class="marquee-mask overflow-hidden">
			<div class="animate-marquee flex w-max items-center hover:[animation-play-state:paused]">
				{
					[false, true].map((duplicate) => (
						<ul
							class="flex items-center font-mono text-sm text-ink-lo"
							aria-hidden={duplicate || undefined}
						>
							{/* Each half is the stack twice, so a half always exceeds the
							    viewport width and the -50% loop never shows empty track */}
							{[...stack, ...stack].map((tech) => (
								<li class="flex items-center whitespace-nowrap px-5">
									<span aria-hidden="true" class="mr-5 h-1 w-1 rounded-full bg-accent/60" />
									{tech}
								</li>
							))}
						</ul>
					))
				}
			</div>
		</div>
	</div>

	<div class="mx-auto w-full max-w-6xl px-6 lg:px-8">
		<!-- Services -->
		<section id="services" class="reveal scroll-mt-24 py-16 lg:py-24">
			<div class="mb-12 max-w-2xl">
				<p class="eyebrow">services</p>
				<h2 class="mt-3 font-display text-3xl font-semibold text-ink md:text-4xl">
					What I build
				</h2>
				<p class="mt-4 text-lg text-ink-mid">
					I work with product teams directly and through
					<a
						href={company.url}
						target="_blank"
						rel="noopener"
						class="font-medium text-accent-2 hover:underline">{company.name}</a
					>, my software company — {taglineInline}.
				</p>
			</div>
			<!-- Ledger rows: hairlines carry the structure, no cards -->
			<div class="divide-y divide-line/60 border-y border-line/60">
				{
					company.services.map((service) => (
						<article class="grid gap-4 py-8 md:grid-cols-[minmax(0,2fr)_minmax(0,3fr)] md:gap-12">
							<div class="flex items-start gap-4">
								<div class="flex h-11 w-11 flex-shrink-0 items-center justify-center rounded-xl bg-accent-soft">
									<Icon name={service.icon} class="h-5 w-5 text-accent" />
								</div>
								<h3 class="font-display text-xl font-semibold leading-snug text-ink md:text-2xl">
									{service.title}
								</h3>
							</div>
							<p class="leading-relaxed text-ink-mid md:pt-1.5">{service.description}</p>
						</article>
					))
				}
			</div>
		</section>

		<!-- Latest Articles -->
		<section id="featured" class="reveal scroll-mt-24 py-16 lg:py-24">
			<div class="mb-10 flex items-end justify-between">
				<div>
					<p class="eyebrow">writing</p>
					<h2 class="mt-3 font-display text-3xl font-semibold text-ink md:text-4xl">
						Latest articles
					</h2>
					<p class="mt-3 text-ink-mid">
						Field notes on AI engineering, Azure, and the craft of shipping software.
					</p>
				</div>
				<a
					href="/blog"
					class="hidden shrink-0 items-center gap-1 font-medium text-accent transition-colors hover:text-accent-strong sm:inline-flex"
				>
					All articles
					<svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"
						></path>
					</svg>
				</a>
			</div>
			<ul class="divide-y divide-line/60 border-y border-line/60">
				{posts.map((post) => <PostRow post={post} />)}
			</ul>
			<a
				href="/blog"
				class="mt-8 inline-flex items-center gap-1 font-medium text-accent sm:hidden"
			>
				All articles →
			</a>
		</section>

		<!-- Projects -->
		<section class="reveal py-16 lg:py-24">
			<div class="mb-10 flex items-end justify-between">
				<div>
					<p class="eyebrow">projects</p>
					<h2 class="mt-3 font-display text-3xl font-semibold text-ink md:text-4xl">
						Things I've shipped
					</h2>
					<p class="mt-3 text-ink-mid">
						Open source tools and builds that solve real problems.
					</p>
				</div>
				<a
					href="/projects"
					class="hidden shrink-0 items-center gap-1 font-medium text-accent transition-colors hover:text-accent-strong sm:inline-flex"
				>
					All projects
					<svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"
						></path>
					</svg>
				</a>
			</div>
			<div class="grid gap-8">
				{projects.map((project) => <ProjectPreview project={project} />)}
			</div>
		</section>

		<!-- Contact -->
		<section class="reveal py-16 lg:py-24">
			<div class="spotlight card-panel relative overflow-hidden rounded-3xl p-10 text-center md:p-16">
				<div
					class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_60%_60%_at_50%_0%,var(--accent-soft),transparent_70%)]"
				>
				</div>
				<div class="relative">
					<p class="eyebrow">contact</p>
					<h2 class="mt-3 font-display text-3xl font-semibold text-ink md:text-4xl">
						Have an AI project in mind?
					</h2>
					<p class="mx-auto mt-4 max-w-xl text-ink-mid">
						Whether you need a production LLM system or a complete intelligent product built
						end-to-end — tell me about it. I respond within one business day, personally or through
						<a
							href={company.url}
							target="_blank"
							rel="noopener"
							class="font-medium text-accent-2 hover:underline">{company.name}</a
						>.
					</p>
					<div class="mt-8 flex flex-wrap items-center justify-center gap-4">
						<a
							href="/about#contact"
							class="inline-flex items-center gap-2 rounded-lg bg-accent px-6 py-3 font-semibold text-abyss transition-all duration-300 hover:-translate-y-1 hover:bg-accent-strong glow-accent"
						>
							Start a conversation
						</a>
						<a
							href={profile.social.github}
							target="_blank"
							rel="noopener"
							class="inline-flex h-12 w-12 items-center justify-center rounded-lg border border-line bg-raised text-ink-mid transition-all duration-300 hover:-translate-y-1 hover:text-accent"
						>
							<span class="sr-only">GitHub</span>
							<svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
								<path
									d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"
								></path>
							</svg>
						</a>
						<a
							href={profile.social.twitter}
							target="_blank"
							rel="noopener"
							class="inline-flex h-12 w-12 items-center justify-center rounded-lg border border-line bg-raised text-ink-mid transition-all duration-300 hover:-translate-y-1 hover:text-accent"
						>
							<span class="sr-only">X (Twitter)</span>
							<svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
								<path
									d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"
								></path>
							</svg>
						</a>
					</div>
				</div>
			</div>
		</section>
	</div>
</Layout>
