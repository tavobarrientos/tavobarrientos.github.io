---
import Layout from '../layouts/Layout.astro';
import Photo from '../components/Photo.astro';
import HeroLights from '../components/HeroLights.astro';
import GitHubActivity from '../components/GitHubActivity.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import profileData from '../data/profile.json';
import { linesOf } from '../data/lines';
import { getCollection } from 'astro:content';

const profile = profileData;
const company = profile.company;

const posts = (await getCollection('blog'))
	.filter((post) => !post.data.hidden)
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 5);

const projects = (await getCollection('projects')).filter((project) => !project.data.hidden);

const fmt = (d: Date) => d.toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
const arrow = 'M3 8h10M9 4l4 4-4 4';
---

<Layout title={SITE_TITLE} description={SITE_DESCRIPTION} fullBleed>
	<!-- Hero: the claim on white, then the site's one photograph in a plate,
	     with its city lights quietly alive (HeroLights). -->
	<section slot="hero" class="container-x pt-32 lg:pt-44">
		<h1 class="rise-lines text-[2.75rem] leading-[1.02] sm:text-7xl lg:text-[6rem]">
			<span class="line" style="--i:0"><span>I build AI systems</span></span>
			<span class="line" style="--i:1"><span>on Azure and .NET,</span></span>
			<span class="line" style="--i:2"><span>and write about it.</span></span>
		</h1>
		<div class="mt-8 grid gap-8 lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] lg:items-end">
			<p class="hero-follow max-w-[54ch] text-lg leading-relaxed text-ink-mid lg:text-xl" style="--i:1">
				I'm {profile.name}, a Microsoft-certified Azure AI engineer. I build agents and
				production LLM systems, and this is where I share what I learn along the way.
			</p>
			<div class="hero-follow flex flex-wrap gap-3 lg:justify-end" style="--i:2">
				<a href="/blog" class="btn btn-solid">
					Read the blog
					<svg class="arrow h-4 w-4" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d={arrow} stroke-linecap="round" stroke-linejoin="round"></path></svg>
				</a>
				<a href="/about#contact" class="btn btn-ghost">Get in touch</a>
			</div>
		</div>
		<div class="plate hero-follow mt-14 aspect-[4/3] bg-[#070b14] sm:aspect-[21/9] lg:mt-20" style="--i:3">
			<!-- The photograph and the lights canvas share one box, so the canvas can
			     place its lights with the same cover maths as the image. The outer
			     layer drifts a few pixels with the pointer (HeroLights.astro) and is
			     slightly oversized so the drift never shows an edge. -->
			<div class="absolute -inset-[1.5%] transition-transform duration-[900ms] ease-out-expo will-change-transform" data-hero-parallax>
				<div class="absolute inset-0 motion-safe:animate-ken-burns">
					<Photo name="earth-night" eager position="center 40%" />
					<HeroLights src="/images/stock/earth-night-1280.webp" aspect={2400 / 1597} posY={0.4} />
				</div>
			</div>
		</div>
		<!-- Scroll cue: pinned to the bottom of the screen while the page is at
		     the top, so it is clear there is more below. It fades out once the
		     visitor scrolls (script at the end of this file). -->
		<a
			href="#more"
			data-scroll-cue
			class="group fixed bottom-6 left-1/2 z-40 inline-flex h-11 -translate-x-1/2 items-center gap-2 rounded-full border border-line bg-white/90 pl-4 pr-3 text-sm font-medium text-ink shadow-[0_6px_24px_rgb(10_15_26/0.12)] backdrop-blur-md transition-[opacity,translate,border-color] duration-300 hover:border-ink data-hidden:pointer-events-none data-hidden:translate-y-3 data-hidden:opacity-0"
		>
			Scroll
			<svg class="h-4 w-4 motion-safe:animate-nudge" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
				<path d="M8 3v10M4 9l4 4 4-4" stroke-linecap="round" stroke-linejoin="round"></path>
			</svg>
		</a>
	</section>
	<!-- Below the hero the page is an index: section name in the left column,
	     content in the right, a rule between sections. No images, no cards. -->
	<div id="more" class="container-x scroll-mt-16">
		<GitHubActivity />

		<section id="writing" class="grid gap-6 border-t border-line py-18 first:border-t-0 lg:grid-cols-[minmax(0,3fr)_minmax(0,9fr)] lg:gap-8 lg:py-30" aria-labelledby="h-writing">
			<h2 id="h-writing" class="font-sans text-[1rem] font-medium leading-normal tracking-normal text-ink-lo font-stretch-[100%] lg:sticky lg:top-24 lg:self-start">Writing</h2>
			<div>
				<ul class="border-b border-line">
					{
						posts.map((post) => (
							<li class="border-t border-line first:border-t-0">
								<a href={`/blog/${post.id}/`} class="grid gap-1.5 py-5.5 sm:grid-cols-[minmax(0,1fr)_auto] sm:items-baseline sm:gap-8">
									<h3 class="text-[length:clamp(1.25rem,1.05rem+0.9vw,1.75rem)] font-[550] leading-tight tracking-[-0.02em]" transition:name={`post-title-${post.id}`}>
										<span class="draw-underline">{post.data.title}</span>
									</h3>
									<p class="tnum flex gap-4 whitespace-nowrap font-mono text-xs text-ink-lo">
										<span>{linesOf(post.data.line).map((l) => l.name).join(' · ')}</span>
										<time datetime={post.data.pubDate.toISOString()}>{fmt(post.data.pubDate)}</time>
									</p>
								</a>
							</li>
						))
					}
				</ul>
				<a href="/blog" class="link-arrow mt-8">
					All articles
					<svg class="arrow h-4 w-4" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d={arrow} stroke-linecap="round" stroke-linejoin="round"></path></svg>
				</a>
			</div>
		</section>

		<section id="services" class="grid gap-6 border-t border-line py-18 first:border-t-0 lg:grid-cols-[minmax(0,3fr)_minmax(0,9fr)] lg:gap-8 lg:py-30 scroll-mt-16" aria-labelledby="h-services">
			<h2 id="h-services" class="font-sans text-[1rem] font-medium leading-normal tracking-normal text-ink-lo font-stretch-[100%] lg:sticky lg:top-24 lg:self-start">Services</h2>
			<div>
				<p class="max-w-[20ch] text-balance font-display text-[length:clamp(2rem,1.2rem+3.4vw,4rem)] font-[650] leading-[1.05] tracking-[-0.035em] text-ink font-stretch-[114%]">{company.tagline}.</p>
				<p class="mt-6 max-w-[56ch] text-lg leading-relaxed text-ink-mid">
					I work with product teams directly and through
					<a
						href={company.url}
						target="_blank"
						rel="noopener"
						class="font-medium text-ink underline decoration-rule underline-offset-4 hover:decoration-ink"
						>{company.name}</a
					>, my software company.
				</p>
				<ul class="mt-10 grid gap-x-12 border-t border-line sm:grid-cols-2">
					{company.services.map((service) => <li class="border-b border-line py-4 text-lg font-medium text-ink">{service.title}</li>)}
				</ul>
				<a href="/about" class="link-arrow mt-8">
					More about me and my services
					<svg class="arrow h-4 w-4" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d={arrow} stroke-linecap="round" stroke-linejoin="round"></path></svg>
				</a>
			</div>
		</section>

		<section class="grid gap-6 border-t border-line py-18 first:border-t-0 lg:grid-cols-[minmax(0,3fr)_minmax(0,9fr)] lg:gap-8 lg:py-30" aria-labelledby="h-projects">
			<h2 id="h-projects" class="font-sans text-[1rem] font-medium leading-normal tracking-normal text-ink-lo font-stretch-[100%] lg:sticky lg:top-24 lg:self-start">Projects</h2>
			<ul class="border-b border-line">
				{
					projects.map((project) => (
						<li class="border-t border-line first:border-t-0">
							<a href={`/projects/${project.id}/`} class="grid gap-1.5 py-5.5">
								<div>
									<h3 class="text-[length:clamp(1.25rem,1.05rem+0.9vw,1.75rem)] font-[550] leading-tight tracking-[-0.02em]" transition:name={`project-title-${project.id}`}>
										<span class="draw-underline">{project.data.title}</span>
									</h3>
									<p class="mt-2 max-w-[60ch] leading-relaxed text-ink-mid">{project.data.description}</p>
								</div>
							</a>
						</li>
					))
				}
			</ul>
		</section>

		<section class="grid gap-6 border-t border-line py-18 first:border-t-0 lg:grid-cols-[minmax(0,3fr)_minmax(0,9fr)] lg:gap-8 lg:py-30" aria-labelledby="h-contact">
			<h2 id="h-contact" class="font-sans text-[1rem] font-medium leading-normal tracking-normal text-ink-lo font-stretch-[100%] lg:sticky lg:top-24 lg:self-start">Contact</h2>
			<div>
				<p class="max-w-[20ch] text-balance font-display text-[length:clamp(2rem,1.2rem+3.4vw,4rem)] font-[650] leading-[1.05] tracking-[-0.035em] text-ink font-stretch-[114%]">Working on an AI project? Let's talk.</p>
				<p class="mt-6 max-w-[54ch] text-lg leading-relaxed text-ink-mid">
					Tell me what you're building. I'll get back to you within one business day.
				</p>
				<div class="mt-8 flex flex-wrap gap-3">
					<a href="/about#contact" class="btn btn-solid">
						Get in touch
						<svg class="arrow h-4 w-4" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d={arrow} stroke-linecap="round" stroke-linejoin="round"></path></svg>
					</a>
					<a href={profile.social.github} target="_blank" rel="noopener" class="btn btn-ghost">GitHub</a>
				</div>
			</div>
		</section>
	</div>
</Layout>

<script>
	// The scroll cue shows only while the page is near the top
	function syncCue() {
		const cue = document.querySelector<HTMLElement>('[data-scroll-cue]');
		if (!cue) return;
		const gone = window.scrollY > 80;
		cue.toggleAttribute('data-hidden', gone);
		// Out of the tab order once it is invisible
		cue.tabIndex = gone ? -1 : 0;
	}
	syncCue();
	document.addEventListener('astro:page-load', syncCue);
	window.addEventListener('scroll', syncCue, { passive: true });
</script>
