---
import Layout from '../../../layouts/Layout.astro';
import type { GetStaticPathsOptions, Page } from 'astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { BLOG_PAGE_SIZE } from '../../../consts';
import PostRow from '../../../components/PostRow.astro';
import SchemaOrg from '../../../components/SchemaOrg.astro';
import Pagination from '../../../components/Pagination.astro';
import PageHero from '../../../components/PageHero.astro';
import TopicFilter from '../../../components/TopicFilter.astro';

// Pages 2 and up of the blog list, built with Astro's paginate().
// Page 1 lives at /blog (blog/index.astro), so it is not generated here.
export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const posts = (await getCollection('blog'))
    .filter((post) => !post.data.hidden)
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

  return paginate(posts, { pageSize: BLOG_PAGE_SIZE }).filter((p) => String(p.params.page) !== '1');
}

type Props = { page: Page<CollectionEntry<'blog'>> };
const { page } = Astro.props;
const posts = page.data;
const currentPage = page.currentPage;
const totalPages = page.lastPage;
const pageTitle = `Blog | Page ${currentPage} | Gustavo Barrientos`;
const pageDescription = `Page ${currentPage} of articles and tutorials about software development, Azure, AI and more`;

// paginate() points page 2 back at /blog/page/1, which is served as /blog
const prevPage = currentPage === 2 ? '/blog' : page.url.prev;
const nextPage = page.url.next;
---

<Layout title={pageTitle} description={pageDescription}>
	<Fragment slot="head">
		<SchemaOrg title={pageTitle} description={pageDescription} type="WebPage" />
		{prevPage && <link rel="prev" href={prevPage} />}
		{nextPage && <link rel="next" href={nextPage} />}
	</Fragment>

	<PageHero
		slot="hero"
		photo="circuit"
		title="Field notes"
		lead="Tutorials, guides, and insights on AI engineering, Azure, and software development."
	/>

	<TopicFilter />

	<!-- Article ledger -->
	<section class="mb-12">
		<ul class="divide-y divide-line border-y border-line" data-stagger>
			{posts.map((post) => <PostRow post={post} />)}
		</ul>
	</section>

	<Pagination currentPage={currentPage} totalPages={totalPages} />
</Layout>
