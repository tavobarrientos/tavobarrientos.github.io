---
import Layout from '../layouts/Layout.astro';
import { Icon } from 'astro-icon/components';
import PageHero from '../components/PageHero.astro';
import profileData from '../data/profile.json';

const profile = profileData;
const company = profile.company;

const experienceYears = parseInt(profile.experience, 10) || 0;
---

<Layout
	title="About Me - Gustavo Barrientos"
	description="About Gustavo Barrientos: a software engineer with 15+ years of experience in Azure AI and .NET, and how to work with him."
>
	<!-- reCAPTCHA Script: data-astro-rerun re-executes it after client-side
	     navigations so the widget renders on every arrival at this page -->
	<script src="https://www.google.com/recaptcha/api.js" async defer is:inline data-astro-rerun
	></script>

	<PageHero slot="hero" photo="office" tall title={`About ${profile.name.split(' ')[0]}`} lead={profile.about.intro}>
		<div class="flex flex-wrap gap-3">
			<a href="/cv/gustavo-barrientos-cv.pdf" download="Gustavo_Barrientos_CV.pdf" class="btn btn-solid">
				<Icon name="heroicons:document-arrow-down" class="h-5 w-5" />
				Download my résumé (PDF)
			</a>
			<a href="#contact" class="btn btn-ghost">Let's work together</a>
		</div>
	</PageHero>

	<div>
	<!-- Credentials -->
	<section id="credentials" class="pb-12 lg:pb-16" data-reveal>
		<dl class="grid grid-cols-2 border-y border-line md:grid-cols-4">
			<div class="border-b border-line py-6 pr-4 md:border-b-0 md:border-r md:pr-6">
				<dd class="tnum font-display text-3xl font-semibold">{experienceYears}+</dd>
				<dt class="mt-1 text-sm text-ink-mid">Years of experience</dt>
			</div>
			<div class="border-b border-line py-6 pl-4 md:border-b-0 md:border-r md:px-6">
				<dd class="tnum font-display text-3xl font-semibold">50+</dd>
				<dt class="mt-1 text-sm text-ink-mid">Projects delivered</dt>
			</div>
			<div class="py-6 pr-4 md:border-r md:border-line md:px-6">
				<dd class="font-display text-3xl font-semibold">AI-102</dd>
				<dt class="mt-1 text-sm text-ink-mid">Certified Azure AI Engineer</dt>
			</div>
			<div class="py-6 pl-4 md:pl-6">
				<dd class="font-display text-3xl font-semibold">GMT-6</dd>
				<dt class="mt-1 text-sm text-ink-mid">Remote-first, async-friendly</dt>
			</div>
		</dl>
	</section>

	<!-- Highlights, beside the portrait -->
	<section class="grid gap-12 py-12 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-20 lg:py-16">
		<div class="zoom-frame rounded-lg" data-reveal="wipe">
			<img
				src="/images/portrait.webp"
				alt={profile.avatar.alt}
				width="1000"
				height="1172"
				class="aspect-[6/7] w-full object-cover"
				loading="lazy"
				decoding="async"
			/>
		</div>
		<div>
			<h2 class="text-4xl font-semibold md:text-5xl" data-reveal>Key highlights</h2>
			<ul class="mt-8 divide-y divide-line border-y border-line" data-stagger>
				{
					profile.about.highlights.map((highlight) => (
						<li class="py-5" data-reveal><p class="max-w-[60ch] text-lg leading-relaxed text-ink-mid">{highlight}</p></li>
					))
				}
			</ul>
			<p class="data-label mt-4">{profile.location}</p>
		</div>
	</section>

	<!-- Skills: one column per category, plain names -->
	<section id="skills" class="scroll-mt-16 py-12 lg:py-16">
		<h2 class="text-4xl font-semibold md:text-5xl" data-reveal>Technical expertise</h2>
		<div class="mt-8 grid gap-x-12 gap-y-10 md:grid-cols-2">
			{
				profile.skills.map((category) => (
					<div>
						<h3 class="border-b border-line pb-2 font-display text-xl font-bold">{category.category}</h3>
						<ul class="mt-3 divide-y divide-line">
							{category.items.map((skill) => (
								<li class="flex items-center gap-3 py-2.5">
									<Icon name={skill.icon} class="h-5 w-5 shrink-0 text-ink-lo" />
									<span class="font-medium text-ink">{skill.name}</span>
								</li>
							))}
						</ul>
					</div>
				))
			}
		</div>
	</section>

	<!-- Services / Ambystech -->
	<section class="py-12 lg:py-16">
		<div data-reveal>
			<h2 class="text-4xl font-semibold md:text-5xl">Consulting &amp; services</h2>
			<p class="mt-4 max-w-[60ch] text-lg leading-relaxed text-ink-mid">
				I work with clients directly and through <span class="font-semibold text-ink">{company.name}</span
				>, my software company. {company.tagline}.
			</p>
		</div>
		<dl class="mt-8 divide-y divide-line border-y border-line">
			{
				company.services.map((service) => (
					<div class="grid gap-3 py-8 md:grid-cols-[minmax(0,2fr)_minmax(0,3fr)] md:gap-12">
						<dt class="font-display text-2xl font-bold leading-snug">{service.title}</dt>
						<dd class="max-w-[60ch] leading-relaxed text-ink-mid">{service.description}</dd>
					</div>
				))
			}
		</dl>
		<div class="mt-8 flex flex-wrap gap-3">
			<a href={company.url} target="_blank" rel="noopener" aria-label="Visit ambystech.com" class="btn btn-ghost gap-3">
				<img src="/images/ambystech-lockup-dark.png" alt="" width="498" height="96" loading="lazy" decoding="async" class="h-6 w-auto" />
				<Icon name="heroicons:arrow-top-right-on-square" class="h-4 w-4" />
			</a>
		</div>
	</section>

		<!-- Contact Form Section -->
		<section class="scroll-mt-24 py-12 lg:py-16" id="contact">
			<div class="max-w-2xl">
				<div class="mb-8" data-reveal>
					<h2 class="text-4xl font-semibold md:text-5xl">Let's work together</h2>
					<p class="mt-4 max-w-[55ch] text-lg leading-relaxed text-ink-mid">
						Whether you're planning a new product or bringing AI into an existing platform, tell
						me about it. I usually reply within one business day.
					</p>
				</div>

				<form
					action="https://api.web3forms.com/submit"
					method="POST"
					class="space-y-6 rounded-lg bg-surface p-6 sm:p-8"
				>
					<input type="hidden" name="access_key" value="3605798a-7225-4eab-9e19-d255812085d7" />
					<input type="hidden" name="subject" value="New Contact Form Submission from Portfolio" />
					<input type="hidden" name="from_name" value="Portfolio Contact Form" />

					<div class="grid md:grid-cols-2 gap-6">
						<div>
							<label for="name" class="mb-2 block font-display text-sm font-bold text-ink">Name *</label>
							<input
								type="text"
								id="name"
								name="name"
								required
								class="min-h-12 w-full rounded-lg border border-rule bg-raised px-4 py-3 text-ink placeholder:text-ink-lo focus:outline-2 focus:outline-offset-2 focus:outline-accent"
								placeholder="Your full name"
							/>
						</div>
						<div>
							<label for="email" class="mb-2 block font-display text-sm font-bold text-ink">Email *</label>
							<input
								type="email"
								id="email"
								name="email"
								required
								class="min-h-12 w-full rounded-lg border border-rule bg-raised px-4 py-3 text-ink placeholder:text-ink-lo focus:outline-2 focus:outline-offset-2 focus:outline-accent"
								placeholder="your.email@example.com"
							/>
						</div>
					</div>

					<div>
						<label for="company" class="mb-2 block font-display text-sm font-bold text-ink">Company</label>
						<input
							type="text"
							id="company"
							name="company"
							class="min-h-12 w-full rounded-lg border border-rule bg-raised px-4 py-3 text-ink placeholder:text-ink-lo focus:outline-2 focus:outline-offset-2 focus:outline-accent"
							placeholder="Your company name (optional)"
						/>
					</div>

					<div>
						<label for="project-type" class="mb-2 block font-display text-sm font-bold text-ink">Project type</label>
						<select
							id="project-type"
							name="project_type"
							class="min-h-12 w-full rounded-lg border border-rule bg-raised px-4 py-3 text-ink placeholder:text-ink-lo focus:outline-2 focus:outline-offset-2 focus:outline-accent"
						>
							<option value="">Select a project type</option>
							<option value="web-development">Web Development</option>
							<option value="ai-integration">AI Integration</option>
							<option value="cloud-architecture">Cloud Architecture</option>
							<option value="consulting">Technical Consulting</option>
							<option value="other">Other</option>
						</select>
					</div>

					<div>
						<label for="message" class="mb-2 block font-display text-sm font-bold text-ink">Message *</label>
						<textarea
							id="message"
							name="message"
							rows="5"
							required
							class="min-h-12 w-full rounded-lg border border-rule bg-raised px-4 py-3 text-ink placeholder:text-ink-lo focus:outline-2 focus:outline-offset-2 focus:outline-accent"
							placeholder="Tell me about your project, goals, and how I can help..."></textarea>
					</div>

					<!-- reCAPTCHA -->
					<div class="flex">
						<div class="g-recaptcha my-4 inline-block" data-sitekey="6LfOMYwrAAAAAEOw96zDGnyjuJPqzxr3J6fYMnDY"></div>
					</div>

					<div class="flex items-center">
						<input
							type="checkbox"
							id="privacy"
							name="privacy_accepted"
							required
							class="h-5 w-5 accent-[var(--accent)]"
						/>
						<label for="privacy" class="ml-2 text-sm text-ink-mid">
							I agree to the privacy policy and consent to data processing *
						</label>
					</div>

					<button
						type="submit"
						class="btn btn-solid w-full justify-center"
					>
						Send message
					</button>
				</form>
			</div>
		</section>
	</div>
</Layout>
<script>
	// Form submission handling
	const handleFormSubmission = () => {
		const form = document.querySelector('form') as HTMLFormElement;
		if (!form) return;

		form.addEventListener('submit', async (e) => {
			e.preventDefault();

			// Validate reCAPTCHA
			const recaptchaResponse = (window as any).grecaptcha?.getResponse();
			if (!recaptchaResponse) {
				alert('Please complete the reCAPTCHA verification.');
				return;
			}

			const submitButton = form.querySelector('button[type="submit"]') as HTMLButtonElement;
			const originalText = submitButton.innerHTML;

			// Show loading state
			submitButton.innerHTML = '<svg class="animate-spin w-5 h-5 mr-2" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>Sending...';
			submitButton.disabled = true;

			try {
				const formData = new FormData(form);

				// Add reCAPTCHA response to form data
				if (recaptchaResponse) {
					formData.delete('g-recaptcha-response');
				}

				const response = await fetch(form.action, {
					method: 'POST',
					body: formData
				});

				if (response.ok) {
					// Success
					form.innerHTML = '<div class="mt-4 bg-ink p-4 text-center font-semibold text-paper">Thanks! Your message was sent. I\'ll get back to you within one business day.</div>';
				} else {
					throw new Error('Form submission failed');
				}
			} catch (error) {
				// Error
				submitButton.innerHTML = originalText;
				submitButton.disabled = false;

				// Reset reCAPTCHA
				if ((window as any).grecaptcha) {
					(window as any).grecaptcha.reset();
				}

				alert('Sorry, your message could not be sent. Please try again in a moment.');
			}
		});
	};

	// Runs on first load and on every client-side navigation back to this page.
	// The wired flag lives on the form's own DOM (fresh per navigation), so
	// the double astro:page-load on initial visits can't attach anything twice.
	function initAboutPage() {
		const form = document.querySelector<HTMLFormElement>('form[action*="web3forms"]');
		if (!form || form.dataset.wired) return;
		form.dataset.wired = '1';
		handleFormSubmission();
	}

	initAboutPage();
	document.addEventListener('astro:page-load', initAboutPage);
</script>
