---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import ProjectPreview from '../../components/ProjectPreview.astro';
import SchemaOrg from '../../components/SchemaOrg.astro';

// Get all projects, filter out hidden ones, and sort by newest first
const allProjects = (await getCollection('projects'))
  .filter(project => !project.data.hidden)
  .sort((a, b) => b.id.localeCompare(a.id));

const pageTitle = "Projects | Gustavo Barrientos";
const pageDescription = "Explore my portfolio of software development projects, including web applications, tools, and open-source contributions.";
---

<Layout
	title={pageTitle}
	description={pageDescription}
	keywords="projects, portfolio, software development, web applications, open source"
>
	<Fragment slot="head">
		<SchemaOrg title={pageTitle} description={pageDescription} type="WebPage" />
	</Fragment>

	<!-- Projects Header -->
	<section class="mb-16 text-center">
		<div class="mx-auto max-w-4xl">
			<h1 class="mb-6 text-4xl font-bold text-ink lg:text-5xl">My Projects</h1>
			<p class="mx-auto max-w-3xl text-xl leading-relaxed text-ink-mid">
				A collection of software projects I've built, ranging from web applications to developer
				tools and open-source contributions.
			</p>
		</div>
	</section>

	{
		allProjects.length > 0 ? (
			<div class="grid gap-8 md:grid-cols-2">
				{allProjects.map((project) => (
					<ProjectPreview project={project} />
				))}
			</div>
		) : (
			<div class="py-16 text-center text-ink-mid">
				<p>No projects to display at the moment. Check back soon!</p>
			</div>
		)
	}
</Layout>
