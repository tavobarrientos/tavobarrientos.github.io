---
// Four topics as a ruled table: name, what it covers, how many posts, and the
// newest one. Counts and titles come from the collection.
import { getCollection } from 'astro:content';
import { LINES, lineById, type LineId } from '../data/lines';

const posts = (await getCollection('blog'))
	.filter((p) => !p.data.hidden)
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const topics = LINES.map((l) => {
	const mine = posts.filter((p) => lineById(p.data.line as LineId | undefined).id === l.id);
	return { ...l, count: mine.length, latest: mine[0] };
}).filter((t) => t.count > 0);
---

<ul class="grid border-y border-line sm:grid-cols-2 lg:grid-cols-4">
	{
		topics.map((t) => (
			<li class={`line-${t.id} border-line p-5 max-lg:border-b max-lg:last:border-b-0 lg:border-r lg:last:border-r-0 lg:first:pl-0 lg:last:pr-0`}>
				<p class="line-chip">{t.name}</p>
				<p class="mt-3 text-sm leading-relaxed text-ink-mid">{t.blurb}</p>
				<p class="data-label mt-4">{t.count} {t.count === 1 ? 'article' : 'articles'}</p>
				<a
					href={`/blog/${t.latest.id}/`}
					class="mt-1 block text-sm font-medium leading-snug text-ink underline decoration-transparent underline-offset-4 hover:decoration-accent"
				>
					{t.latest.data.title}
				</a>
			</li>
		))
	}
</ul>
