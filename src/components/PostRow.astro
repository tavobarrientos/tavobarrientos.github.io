---
import { getReadingTime } from '../utils/readingTime';
import { linesOf, type LineField } from '../data/lines';

interface Props {
	post: {
		id: string;
		body?: string;
		data: {
			title: string;
			description: string;
			pubDate: Date;
			heroImage?: string;
			line?: LineField;
		};
	};
}

const { post } = Astro.props;
const { title, description, pubDate } = post.data;
const readingTime = getReadingTime(post.body ?? '');
const lines = linesOf(post.data.line);
const line = lines[0];

const date = pubDate.toLocaleDateString('en-US', {
	month: 'short',
	day: '2-digit',
	year: 'numeric',
});
---

<!-- Article row (it lifts onto the surface colour under the pointer, bleeding
     a little past the column so the text does not shift): topic and date in the gutter, title and summary. The title carries a per-slug
     view-transition name so opening an article morphs it into the page hero. -->
<li data-reveal>
	<a
		href={`/blog/${post.id}/`}
		class={`line-${line.id} -mx-4 grid rounded-[10px] px-4 transition-colors duration-[250ms] hover:bg-surface focus-visible:bg-surface grid-cols-1 items-center gap-x-8 gap-y-3 py-7 sm:grid-cols-[9rem_minmax(0,1fr)] lg:grid-cols-[10rem_minmax(0,1fr)]`}
	>
		<div class="flex flex-row items-baseline gap-4 self-start sm:flex-col sm:gap-2 sm:pt-1.5">
			<span class="flex flex-wrap gap-x-3 gap-y-2">{lines.map((l) => <span class={`line-chip line-${l.id}`}>{l.name}</span>)}</span>
			<time datetime={pubDate.toISOString()} class="font-mono text-xs text-ink-lo">{date}</time>
		</div>
		<div class="min-w-0">
			<h3
				class="font-display text-xl font-semibold leading-snug text-ink md:text-2xl"
				transition:name={`post-title-${post.id}`}
			>
				<span class="draw-underline">{title}</span>
			</h3>
			{description && description.trim() !== title.trim() && <p class="mt-2 max-w-[62ch] leading-relaxed text-ink-mid line-clamp-2">{description}</p>}
			<p class="mt-2 font-mono text-xs text-ink-lo">{readingTime}</p>
		</div>
	</a>
</li>
