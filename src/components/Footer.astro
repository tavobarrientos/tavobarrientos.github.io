---
const today = new Date();
---

<footer class="border-t border-line">
	<div class="container-x py-14">
		<div class="grid gap-10 md:grid-cols-[minmax(0,2fr)_minmax(0,1fr)_minmax(0,1fr)]">
			<div class="max-w-md">
				<p class="font-display text-xl font-semibold text-ink">Gustavo Barrientos</p>
				<p class="mt-3 leading-relaxed text-ink-mid">
					AI engineer building agents and production LLM systems, independently and through
					<a
						href="https://www.ambystech.com"
						target="_blank"
						rel="noopener"
						class="font-medium text-ink underline decoration-rule underline-offset-4 hover:decoration-ink">Ambystech</a
					>. Monterrey, Mexico.
				</p>
			</div>

			<nav aria-label="Footer" class="flex flex-col text-ink-mid">
				<a href="/" class="inline-flex min-h-11 w-fit items-center transition-colors duration-200 hover:text-ink">Home</a>
				<a href="/blog" class="inline-flex min-h-11 w-fit items-center transition-colors duration-200 hover:text-ink">Writing</a>
				<a href="/projects" class="inline-flex min-h-11 w-fit items-center transition-colors duration-200 hover:text-ink">Projects</a>
				<a href="/about" class="inline-flex min-h-11 w-fit items-center transition-colors duration-200 hover:text-ink">About</a>
			</nav>

			<nav aria-label="Elsewhere" class="flex flex-col text-ink-mid">
				<a href="/about#contact" class="inline-flex min-h-11 w-fit items-center transition-colors duration-200 hover:text-ink">Contact</a>
				<a href="https://github.com/tavobarrientos" target="_blank" rel="noopener" class="inline-flex min-h-11 w-fit items-center transition-colors duration-200 hover:text-ink">GitHub</a>
				<a href="https://twitter.com/tavobarrientos" target="_blank" rel="noopener" class="inline-flex min-h-11 w-fit items-center transition-colors duration-200 hover:text-ink">X</a>
				<a href="/rss.xml" class="inline-flex min-h-11 w-fit items-center transition-colors duration-200 hover:text-ink">RSS</a>
			</nav>
		</div>

		<!-- The name once more, sized from the column (cqw) so it always spans it exactly -->
		<div class="@container mt-14 overflow-hidden">
			<p
				class="select-none whitespace-nowrap pb-6 font-display text-[length:10.4cqw] font-[650] leading-[0.95] tracking-[-0.045em] text-[#eceef3] font-stretch-[125%]"
				aria-hidden="true"
			>
				Gustavo Barrientos
			</p>
		</div>

		<div class="tnum flex flex-wrap justify-between gap-2 border-t border-line pt-6 font-mono text-xs text-ink-lo">
			<p>© {today.getFullYear()} Gustavo Barrientos</p>
			<p>Photos from Unsplash</p>
		</div>
	</div>
</footer>
