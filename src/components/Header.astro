---
import NavBar from './NavBar.astro';
---

<!-- Full-width HUD bar. transition:persist keeps this exact DOM (and the
     spring physics attached to it) alive across client-side navigations;
     nav-physics.ts re-syncs the active link on astro:page-load. -->
<header transition:persist="hud" class="animate-nav-drop fixed inset-x-0 top-0 z-50">
	<NavBar />
</header>
