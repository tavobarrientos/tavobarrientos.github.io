---
import NavBar from './NavBar.astro';
---

<!-- Positioning shell only: the nav itself lives in NavBar.astro. The wrapper
     carries the drop-in entrance so it never fights the physics transforms
     applied to the capsule inside. -->
<header class="animate-nav-drop pointer-events-none fixed inset-x-0 top-4 z-50 flex justify-center px-4">
	<NavBar />
</header>
