---
import OptimizedImage from './OptimizedImage.astro';

interface Props {
  project: {
    slug: string;
    data: {
      title: string;
      description: string;
      heroImage?: string;
      images?: string[];
      links?: {
        github?: string;
        website?: string;
        demo?: string;
      };
      tags?: string[];
      hidden?: boolean;
    };
  };
}

const { project } = Astro.props;
const { title, description, heroImage, links, tags } = project.data;

const href = `/projects/${project.slug}/`;
---

<article
  class="group flex h-full flex-col overflow-hidden rounded-xl border border-line bg-surface hover-lift"
>
  <a href={href} aria-label={title} class="flex flex-grow flex-col no-underline text-inherit">
    {
      heroImage && (
        <div class="relative aspect-video w-full overflow-hidden bg-raised">
          <OptimizedImage
            width={400}
            height={250}
            src={heroImage}
            alt={`Preview image for ${title}`}
            sizes="(max-width: 480px) 100vw, (max-width: 768px) 50vw, 33vw"
            class="h-full w-full"
            css="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
          />
        </div>
      )
    }
    <div class="flex flex-grow flex-col p-6">
      <h2
        class="mb-3 text-xl font-bold text-ink transition-colors duration-200 group-hover:text-accent"
      >
        {title}
      </h2>
      <p class="mb-4 flex-grow leading-relaxed text-ink-mid">{description}</p>

      {
        tags && tags.length > 0 && (
          <div class="mt-auto flex flex-wrap gap-2">
            {tags.map((tag) => (
              <span class="rounded-md bg-accent-soft px-2 py-1 text-xs font-medium text-accent">
                {tag}
              </span>
            ))}
          </div>
        )
      }
    </div>
  </a>

  {
    links && (
      <div class="flex flex-wrap gap-4 border-t border-line px-6 py-4">
        {links.github && (
          <a
            href={links.github}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 text-sm font-medium text-ink-mid transition-colors hover:text-accent"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" />
            </svg>
            GitHub
          </a>
        )}
        {links.website && (
          <a
            href={links.website}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 text-sm font-medium text-ink-mid transition-colors hover:text-accent"
          >
            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <circle cx="12" cy="12" r="10" />
              <line x1="2" y1="12" x2="22" y2="12" />
              <path d="m2 12c2.5-4 6-6 10-6s7.5 2 10 6c-2.5 4-6 6-10 6s-7.5-2-10-6z" />
            </svg>
            Website
          </a>
        )}
        {links.demo && (
          <a
            href={links.demo}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 text-sm font-medium text-ink-mid transition-colors hover:text-accent"
          >
            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <polygon points="5 3 19 12 5 21 5 3" />
            </svg>
            Demo
          </a>
        )}
      </div>
    )
  }
</article>
