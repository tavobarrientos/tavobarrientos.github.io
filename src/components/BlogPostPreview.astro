---
import FormattedDate from './FormattedDate.astro';
import { getReadingTime } from '../utils/readingTime';

interface Props {
  post: {
    slug: string;
    body?: string;
    data: {
      title: string;
      description: string;
      pubDate: Date;
      updatedDate?: Date;
      heroImage?: string;
      author?: {
        id: string;
      };
    };
  };
}

const { post } = Astro.props;
const { title, description, pubDate, heroImage } = post.data;
const readingTime = getReadingTime(post.body ?? '');

const href = `/blog/${post.slug}/`;
---

<article
  class="group flex h-full flex-col overflow-hidden rounded-xl border border-line bg-surface hover-lift"
>
  <a href={href} aria-label={title} class="flex h-full flex-col no-underline text-inherit">
    {
      heroImage && (
        <div class="relative aspect-video w-full overflow-hidden bg-raised">
          <img
            width={720}
            height={360}
            src={heroImage}
            alt={`Cover image for ${title}`}
            loading="lazy"
            decoding="async"
            sizes="(max-width: 480px) 100vw, (max-width: 768px) 50vw, 33vw"
            class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
          />
        </div>
      )
    }
    <div class="flex flex-grow flex-col p-6">
      <header class="mb-4">
        <h2
          class="mb-2 text-xl font-bold text-ink transition-colors duration-200 group-hover:text-accent line-clamp-2"
        >
          {title}
        </h2>
        <div class="flex items-center gap-2 text-sm text-ink-lo">
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
            ></path>
          </svg>
          <FormattedDate date={pubDate} />
        </div>
      </header>
      <p class="mb-4 flex-grow leading-relaxed text-ink-mid line-clamp-3">{description}</p>
      <div class="flex items-center justify-between border-t border-line pt-4">
        <span class="inline-flex items-center text-sm font-medium text-accent">
          Read article
          <svg
            class="ml-1 h-4 w-4 transition-transform duration-300 group-hover:translate-x-1"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"
            ></path>
          </svg>
        </span>
        <div class="flex items-center gap-1.5 text-xs text-ink-lo">
          <svg class="h-3 w-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"
            ></path>
          </svg>
          <span>{readingTime}</span>
        </div>
      </div>
    </div>
  </a>
</article>
