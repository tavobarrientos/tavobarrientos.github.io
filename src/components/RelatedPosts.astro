---
import { getEntries, type CollectionEntry } from 'astro:content';
import PostCard from './PostCard.astro';

const { related } = Astro.props;

const relatedPosts = ((await getEntries(related)) as CollectionEntry<'blog'>[]).filter(
	(p) => p && !p.data.hidden
);
---

{
	relatedPosts.length > 0 && (
		<section aria-labelledby="related-heading">
			<h2 id="related-heading" class="text-2xl font-semibold md:text-3xl">
				Related articles
			</h2>
			<ul class="mt-6 grid gap-x-8 gap-y-10 sm:grid-cols-2 lg:grid-cols-3" data-stagger>
				{relatedPosts.map((post) => (
					<li data-reveal>
						<PostCard post={post} />
					</li>
				))}
			</ul>
		</section>
	)
}
