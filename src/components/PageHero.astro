---
// The opening of every inner page: the title set large on white, nothing
// behind it. `image` (a post's own artwork) is shown below the title in a
// rounded plate. `narrow` aligns the header with the article column.
// `photo` and `tall` are accepted for older callers and ignored.
interface Props {
	title: string;
	lead?: string;
	photo?: string;
	image?: string;
	transitionName?: string;
	tall?: boolean;
	narrow?: boolean;
}
const { title, lead, image, transitionName, narrow = false } = Astro.props;
---

<section class="page-head">
	<div class="container-x pb-10 pt-32 lg:pb-14 lg:pt-44">
		<div class={narrow ? 'mx-auto max-w-[44rem]' : ''}>
			<div class="hero-follow empty:hidden" style="--i:-3"><slot name="above" /></div>
			<h1
				class={`rise-lines leading-[1.04] ${narrow ? 'text-4xl sm:text-5xl lg:text-6xl' : 'max-w-[20ch] text-4xl sm:text-6xl lg:text-7xl'}`}
				transition:name={transitionName}
			>
				<span class="line"><span>{title}</span></span>
			</h1>
			{lead && <p class="hero-follow mt-6 max-w-[58ch] text-lg leading-relaxed text-ink-mid lg:text-xl">{lead}</p>}
			<div class="hero-follow mt-8 empty:hidden" style="--i:1"><slot /></div>
		</div>
	</div>
	{
		image && (
			<div class="container-x">
				<div class="plate hero-follow mx-auto aspect-[16/9] max-w-[64rem] sm:aspect-[2/1]" style="--i:2">
					<img src={image} alt="" loading="eager" fetchpriority="high" decoding="async" />
				</div>
			</div>
		)
	}
</section>
