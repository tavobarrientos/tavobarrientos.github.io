---
import { Image } from 'astro:assets';

/**
 * OptimizedImage Component
 * 
 * A wrapper around Astro's Image component that applies best practices for performance:
 * - Lazy loading
 * - Responsive sizes
 * - Low-quality image placeholder effect
 * - Native lazy loading
 */

interface Props {
  src: string;
  alt: string;
  width: number;
  height: number;
  class?: string;
  sizes?: string;
  priority?: boolean;
  css?: string;
}

const { 
  src, 
  alt, 
  width, 
  height, 
  class: className, 
  sizes = "(max-width: 480px) 100vw, (max-width: 768px) 50vw, 33vw", 
  priority = false,
  css
} = Astro.props;

// Determine if this image should be eagerly loaded (for above the fold content)
const loading = priority ? "eager" : "lazy";
---

<div class={`relative overflow-hidden ${className || ''}`}>
  <Image 
    src={src}
    alt={alt}
    width={width}
    height={height}
    loading={loading}
    decoding={priority ? "sync" : "async"}
    sizes={sizes}
    class={`block motion-safe:animate-fade-soft ${css || ''}`}
  />
</div>
