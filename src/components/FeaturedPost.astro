---
import { getReadingTime } from '../utils/readingTime';
import { linesOf, type LineField } from '../data/lines';

interface Props {
	post: {
		id: string;
		body?: string;
		data: {
			title: string;
			description: string;
			pubDate: Date;
			heroImage?: string;
			line?: LineField;
		};
	};
}

const { post } = Astro.props;
const { title, description, pubDate, heroImage } = post.data;
const readingTime = getReadingTime(post.body ?? '');
const lines = linesOf(post.data.line);
const line = lines[0];

const date = pubDate.toLocaleDateString('en-US', {
	month: 'short',
	day: '2-digit',
	year: 'numeric',
});
---

<!-- The newest article, given the room: a large image that wipes open as it
     enters, with the title set big beside it. -->
<a
	href={`/blog/${post.id}/`}
	class={`line-${line.id} grid items-center gap-8 lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] lg:gap-14`}
>
	{
		heroImage && (
			<div class="zoom-frame aspect-[16/10] rounded-lg bg-surface" data-reveal="wipe">
				<img
					src={heroImage}
					alt=""
					width="1200"
					height="750"
					loading="lazy"
					decoding="async"
					class="h-full w-full object-cover"
				/>
			</div>
		)
	}
	<div data-reveal>
		<p class="flex items-center gap-4">
			{lines.map((l) => <span class={`line-chip line-${l.id}`}>{l.name}</span>)}
			<span class="data-label">Latest</span>
		</p>
		<h3
			class="mt-4 font-display text-3xl font-semibold leading-[1.08] text-ink md:text-5xl"
			transition:name={`post-title-${post.id}`}
		>
			<span class="draw-underline">{title}</span>
		</h3>
		{description && description.trim() !== title.trim() && <p class="mt-5 max-w-[52ch] text-lg leading-relaxed text-ink-mid">{description}</p>}
		<p class="tnum mt-5 flex flex-wrap items-center gap-x-4 font-mono text-xs text-ink-lo">
			<time datetime={pubDate.toISOString()}>{date}</time>
			{readingTime}
		</p>
	</div>
</a>
