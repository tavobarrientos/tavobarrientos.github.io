---
import { getEntry } from "astro:content";
import Gravatar from './Gravatar.astro';

const { author } = Astro.props;

const authorRef = author && await getEntry(author);
---


<div class="author-box">
    <div class="avatar-column">
      <Gravatar email={authorRef.data.email} size={80} />
    </div>
    <div class="info-column">
      <p>Author</p>
      <h5>{authorRef.data.name}</h5>
      <p class="bio">{authorRef.data.bio}</p>
      <p class="email">
        <a href={`mailto:${authorRef.data.email}`}>
          {authorRef.data.email}
        </a>
      </p>
    </div>
  </div>
  
  <style>
        .author-box {
      display: flex;
      align-items: center;
      padding: 1em;
      margin: 2rem 0;
      border-radius: 12px;
      border: 1px solid var(--line);
      background-color: var(--bg-surface);
      flex-wrap: wrap;
      color: var(--text-mid);
    }
    .avatar-column {
      margin-right: 1em;
      flex-shrink: 0;
    }
    .info-column {
      flex: 1;
    }
    .info-column h5 {
      margin: 0 0 0.5em 0;
    }
    .info-column p {
      margin: 0;
    }

    .info-column h5 {
      color: var(--text-hi);
    }

    .info-column .bio {
      margin: 0.5em 0;
      font-size: 0.8em;
      color: var(--text-lo);
    }

    .info-column .email a {
      font-size: 0.9em;
      color: var(--accent);
      text-decoration: none;
    }

    .info-column .email a:hover {
      text-decoration: underline;
    }

    /* Responsive Styles */
    @media (max-width: 720px) {
      .author-box {
        flex-direction: column;
        align-items: flex-start;
      }
      .avatar-column {
        margin-right: 0;
        margin-bottom: 1em;
      }
      .info-column .email {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }
    }
  
    @media (min-width: 721px) and (max-width: 1024px) {
      .author-box {
        flex-direction: row;
      }
      .avatar-column {
        margin-right: 1em;
        margin-bottom: 0;
      }
      .info-column .email {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }
    }
  
    @media (min-width: 1025px) {
      .author-box {
        flex-direction: row;
      }
      .avatar-column {
        margin-right: 1em;
        margin-bottom: 0;
      }
      .info-column .email {
        overflow: visible;
        text-overflow: clip;
        white-space: normal;
      }
    }
  </style>