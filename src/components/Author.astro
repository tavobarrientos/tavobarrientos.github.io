---
import { getEntry } from 'astro:content';
import Gravatar from './Gravatar.astro';

const { author } = Astro.props;

const authorRef = author && (await getEntry(author));
---

{
	authorRef && (
		<div class="flex items-start gap-5">
			<div class="shrink-0">
				<Gravatar email={authorRef.data.email} size={64} alt="" />
			</div>
			<div class="min-w-0">
				<p class="data-label">Written by</p>
				<p class="mt-1 font-display text-lg font-semibold text-ink">{authorRef.data.name}</p>
				{authorRef.data.bio && (
					<p class="mt-1 max-w-[60ch] text-sm leading-relaxed text-ink-mid">{authorRef.data.bio}</p>
				)}
				<p class="mt-2 flex flex-wrap gap-x-5 text-sm">
					<a href="/about" class="link-arrow !min-h-9">About</a>
					<a href="/about#contact" class="link-arrow !min-h-9">Get in touch</a>
				</p>
			</div>
		</div>
	)
}
