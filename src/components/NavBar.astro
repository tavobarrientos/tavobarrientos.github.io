---
const { pathname } = Astro.url;

const links = [
	{ href: '/blog', label: 'Writing' },
	{ href: '/projects', label: 'Projects' },
	{ href: '/about', label: 'About' },
];

const isActive = (href: string) => pathname === href || pathname.startsWith(href + '/');
---

<nav aria-label="Main" class="text-ink" style="height: var(--header-h)">
	<div class="container-x flex h-full items-center justify-between gap-4">
		<a href="/" class="shrink-0 font-display text-[1rem] font-semibold tracking-tight sm:text-lg">
			<span class="sm:hidden" aria-hidden="true">GB</span>
			<span class="sr-only sm:not-sr-only">barrientos.io</span>
		</a>

		<div class="flex items-center gap-1 sm:gap-3">
			<ul class="flex items-center">
				{
					links.map((l) => (
						<li>
							<a
								href={l.href}
								data-nav-link
								aria-current={isActive(l.href) ? 'page' : undefined}
								class="group inline-flex min-h-11 items-center px-2.5 text-sm font-medium text-ink-mid transition-colors duration-200 hover:text-ink aria-[current=page]:text-ink sm:px-3.5"
							>
								<span class="draw-underline group-aria-[current=page]:bg-size-[100%_1.5px]">{l.label}</span>
							</a>
						</li>
					))
				}
			</ul>
			<a href="/about#contact" class="ml-1 inline-flex min-h-10 items-center rounded-full bg-ink px-4 text-sm font-medium text-paper transition-colors duration-[250ms] hover:bg-accent">Contact</a>
		</div>
	</div>
</nav>


<script>
	// The bar persists across client-side navigations, so it is never
	// re-rendered by the server: re-sync the current link by hand.
	function sync() {
		const path = location.pathname;
		document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]').forEach((a) => {
			const href = a.getAttribute('href') ?? '';
			if (path === href || path.startsWith(href + '/')) a.setAttribute('aria-current', 'page');
			else a.removeAttribute('aria-current');
		});
	}
	document.addEventListener('astro:page-load', sync);
</script>
