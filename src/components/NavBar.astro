---
import Gravatar from './Gravatar.astro';
import profileData from '../data/profile.json';

const profile = profileData;
const { pathname } = Astro.url;
const subpath = pathname.match(/[^\/]+/g);

// Links read as shell paths: home is ~, everything else a directory
const links = [
	{ href: '/', label: '~', name: 'Home' },
	{ href: '/about', label: '/about', name: 'About' },
	{ href: '/blog', label: '/blog', name: 'Blog' },
	{ href: '/projects', label: '/projects', name: 'Projects' },
];

const isActive = (href: string) => href === pathname || href === '/' + subpath?.[0];
---

<!-- HUD command bar: a slim full-width strip framing every page. The spring
     indicator and magnetic icons come from nav-physics.ts; everything degrades
     to static styles without JS or with reduced motion. -->
<div data-navbar class="relative">
	<nav
		aria-label="Main"
		class="flex h-14 items-center justify-between gap-4 border-b border-line/60 bg-base/80 px-4 backdrop-blur-xl md:px-8"
	>
		<!-- Identity -->
		<a href="/" class="group flex min-w-0 items-center gap-3">
			<span class="relative flex-shrink-0">
				<Gravatar email={profile.email} size={30} alt="Gustavo Barrientos" />
				<span
					class="absolute -bottom-0.5 -right-0.5 h-2 w-2 rounded-full border-2 border-base bg-green-400"
				></span>
			</span>
			<span class="truncate font-mono text-sm text-ink transition-colors group-hover:text-accent">
				gustavo<span class="text-ink-lo">@barrientos.io</span>
			</span>
		</a>

		<!-- Desktop links + spring indicator -->
		<div data-nav-links class="relative hidden items-center gap-1 md:flex">
			<span
				data-nav-indicator
				aria-hidden="true"
				class="absolute bottom-1 left-0 top-1 rounded-lg bg-accent-soft opacity-0 transition-opacity duration-300 will-change-transform"
				style="width: 0px"></span>
			{
				links.map((link) => (
					<a
						data-nav-link
						href={link.href}
						aria-label={link.name}
						aria-current={isActive(link.href) ? 'page' : undefined}
						class:list={[
							'nav-link relative z-10 rounded-lg px-3 py-1.5 font-mono text-sm transition-colors duration-200',
							isActive(link.href) && 'nav-active',
						]}
					>
						{link.label}
					</a>
				))
			}
		</div>

		<!-- Actions -->
		<div class="flex items-center gap-1">
			<a
				data-magnetic
				href={profile.social.github}
				target="_blank"
				rel="noopener"
				class="hidden rounded-lg p-2 text-ink-lo transition-colors hover:text-accent sm:inline-flex"
			>
				<span class="sr-only">Follow on GitHub</span>
				<svg class="h-4.5 w-4.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
					<path
						d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"
					></path>
				</svg>
			</a>
			<a
				data-magnetic
				href={profile.social.twitter}
				target="_blank"
				rel="noopener"
				class="hidden rounded-lg p-2 text-ink-lo transition-colors hover:text-accent sm:inline-flex"
			>
				<span class="sr-only">Follow on X (Twitter)</span>
				<svg class="h-4.5 w-4.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
					<path
						d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"
					></path>
				</svg>
			</a>

			<!-- Mobile menu button -->
			<button
				id="mobile-menu-button"
				type="button"
				class="rounded-lg p-2 text-ink-mid transition-colors hover:text-ink md:hidden"
				aria-expanded="false"
				aria-controls="mobile-menu"
			>
				<span class="sr-only">Open menu</span>
				<svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"
					></path>
				</svg>
			</button>
		</div>
	</nav>

	<!-- Mobile menu: a full-width console drawer under the bar -->
	<div
		id="mobile-menu"
		class="animate-fade-in-scale absolute inset-x-0 top-full hidden border-b border-line/70 bg-base/95 px-4 py-3 backdrop-blur-xl md:hidden"
	>
		<div class="flex flex-col gap-1">
			{
				links.map((link) => (
					<a
						data-nav-mlink
						href={link.href}
						aria-label={link.name}
						aria-current={isActive(link.href) ? 'page' : undefined}
						class:list={[
							'nav-link rounded-lg px-4 py-3 font-mono text-sm transition-colors',
							isActive(link.href) && 'nav-active',
						]}
					>
						{link.label}
						<span class="ml-3 text-xs text-ink-lo">{link.name.toLowerCase()}</span>
					</a>
				))
			}
		</div>
	</div>
</div>

<style>
	.nav-link {
		color: var(--text-mid);
	}

	.nav-link:hover {
		color: var(--text-hi);
	}

	/* Active state is toggled by nav-physics.ts on client-side navigations
	   (the bar persists and is never re-rendered by the server) */
	.nav-link.nav-active {
		color: var(--accent);
		font-weight: 600;
	}

	/* No-JS / pre-JS fallback: active wash until the spring indicator boots */
	[data-nav-links]:not(.nav-js) .nav-link.nav-active {
		background-color: var(--accent-soft);
	}

	[data-nav-mlink]:hover {
		background-color: var(--bg-raised);
	}
</style>

<script>
	import '../scripts/nav-physics';
</script>
