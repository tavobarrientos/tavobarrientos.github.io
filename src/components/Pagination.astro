---
/**
 * Pagination Component for Blog
 * 
 * This component displays pagination controls for blog pages.
 * It shows:
 * - Previous/next page buttons
 * - First page link
 * - Pages around current page
 * - Last page link
 * - Appropriate ellipses for skipped pages
 * 
 * @prop {number} currentPage - The current page number (1-based)
 * @prop {number} totalPages - Total number of pages
 */

export interface Props {
  currentPage: number;
  totalPages: number;
}

const { currentPage, totalPages } = Astro.props;

// Generate page URLs - /blog for page 1, /blog/page/2+ for other pages
const cell = 'inline-flex h-11 min-w-11 items-center justify-center rounded-full px-3 font-mono text-sm tabular-nums';
const link = (active: boolean) =>
  `${cell} border transition-colors duration-200 ${active ? 'border-ink bg-ink text-paper' : 'border-rule text-ink hover:border-ink'}`;
const ellipsis = `${cell} text-ink-lo max-[360px]:hidden`;

const getPageUrl = (pageNum: number) => `/blog${pageNum > 1 ? `/page/${pageNum}` : ''}`;
---

{totalPages > 1 && (
  <nav class="mt-14 flex flex-wrap items-center justify-center gap-2" aria-label="Blog pagination">
    {/* Previous page button */}
    {currentPage > 1 && (
      <a href={getPageUrl(currentPage - 1)} aria-label="Previous page" class={link(false)}>
        ←
      </a>
    )}
    
    {/* First page */}
    <a href={getPageUrl(1)} class={link(currentPage === 1)} aria-current={currentPage === 1 ? 'page' : null}>
      1
    </a>
    
    {/* Ellipsis for when there are many pages */}
    {currentPage > 3 && (
      <span class={ellipsis} aria-hidden="true">...</span>
    )}
    
    {/* Pages around current page */}
    {Array.from({length: totalPages}).map((_, i) => {
      const pageNum = i + 1;
      // For desktop: Show pages around the current page (current-1, current, current+1)
      // For mobile: Only show current page between first and last (done via CSS)
      if (pageNum !== 1 && pageNum !== totalPages && (pageNum === currentPage - 1 || pageNum === currentPage || pageNum === currentPage + 1)) {
        return (
          <a 
            href={getPageUrl(pageNum)} 
            class={`${link(pageNum === currentPage)} ${pageNum !== currentPage ? 'max-[360px]:hidden' : ''}`}
            aria-current={pageNum === currentPage ? 'page' : null}>
            {pageNum}
          </a>
        )
      }
      return null;
    })}
    
    {/* Ellipsis for when there are many pages */}
    {currentPage < totalPages - 2 && (
      <span class={ellipsis} aria-hidden="true">...</span>
    )}
    
    {/* Last page (if more than 1 page) */}
    {totalPages > 1 && (
      <a 
        href={getPageUrl(totalPages)} 
        class={link(currentPage === totalPages)} 
        aria-current={currentPage === totalPages ? 'page' : null}>
        {totalPages}
      </a>
    )}
    
    {/* Next page button */}
    {currentPage < totalPages && (
      <a href={getPageUrl(currentPage + 1)} aria-label="Next page" class={link(false)}>
        →
      </a>
    )}
  </nav>
)}
